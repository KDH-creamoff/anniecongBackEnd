<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title>라벨</title>
    <style>
      @page {
        size: <%= labelSize === 'large' ? '100mm 100mm' : labelSize === 'medium' ? '80mm 60mm' : '50mm 30mm' %>;
        margin: 0;
      }
      body {
        margin: 0;
        padding: 0;
        font-family: 'Nanum Gothic', sans-serif;
        height: 100%;
      }
      .label-content {
        width: 100%;
        height: 100%;
        justify-content: center;
        align-items: center;
        text-align: center;
      }
      h1, h2, p {
        margin: 0;
        padding: 0;
      }

      /* ---------- Large 전용 스타일 ---------- */
      .label-large {
        width: 100%;
        height: 100%;
        padding: 10px 14px;
        box-sizing: border-box;
        font-size: 9pt;
        line-height: 1.4;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .large-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }
      .large-title {
        font-size: 16pt;
        font-weight: bold;
      }
      .frozen-badge {
        border: 1.5px solid #000;
        border-radius: 6px;
        padding: 4px;
        width: 60px;
        height: 60px;
        text-align: center;
        font-size: 7pt;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .frozen-badge svg {
        width: 28px;
        height: 28px;
        margin-bottom: 2px;
      }
      .large-info p {
        margin: 2px 0;
        text-align: left;
      }
      .large-bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
      }
      .barcode-box {
        text-align: center;
      }
      .barcode-box img {
        width: 140px;
        height: auto;
      }
      .date-box {
        text-align: left;
        font-size: 10pt;
      }
      .microwave-box {
        text-align: center;
        font-size: 8pt;
      }
      .microwave-box svg {
        display: block;
        width: 42px;
        height: 28px;
        margin: 0 auto 2px auto;
      }

      /* ---------- Medium 전용 스타일 ---------- */
      .label-medium {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        height: 100%;
        padding: 8px;
        box-sizing: border-box;
        text-align: left;
      }
      .medium-header {
        font-size: 14pt;
        font-weight: bold;
        margin-bottom: 6px;
      }
      .medium-info {
        font-size: 8pt;
        line-height: 1.4;
        margin-bottom: 4px;
      }

      /* ---------- Small 전용 스타일 ---------- */
      .small-label-container {
        display: flex;
        flex-direction: column;
        font-size: 8pt;
      }
      .small-label {
        margin-bottom: 4px;
      }
      .small-label-barcode {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      h5 {
        transform: rotate(270deg);
        transform-origin: center center;
      }
    </style>
  </head>
  <body>
    <div class="label-content">
      <% if (labelSize === 'large') { %>
        <div class="label-large">
          <!-- 상단: 제품명 + 냉동 배지 -->
          <div class="large-top">
            <div class="large-title"><%= productName %></div>
            <div class="frozen-badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M32 8v48M8 32h48M16 16l32 32M48 16L16 48"/>
              </svg>
              냉동식품
            </div>
          </div>

          <!-- 본문 -->
          <div class="large-info">
            <p>등록번호: <%= registrationNumber %> / 제품명: <%= productName %></p>
            <p>종류 및 형태: <%= productTypeAndForm %></p>
            <p>성분량: <%= ingredientAmount %></p>
            <p>원료의 명칭: <%= ingredientName %></p>
            <p>실제중량: <%= netWeight %></p>
            <p>사료의 용도: <%= feedPurpose %></p>
            <p>제조일자: <%= manufacturingDate %></p>
            <p>유통기한: <%= expiration_date %></p>
            <p>주의사항: <%= precautions %></p>
          </div>

          <!-- 하단: 바코드 + 날짜 + 전자레인지 -->
          <div class="large-bottom">
            <div class="barcode-box">
              <img src="data:image/png;base64,<%= barcodeBase64 %>" alt="Barcode" />
              <div><%= barcord %></div>
            </div>
            <div class="date-box">
              <p>제조일자: <%= manufacturingDate %></p>
              <p>유통기한: <%= expiration_date %></p>
              <p>제품수량: <%= quantity %></p>
            </div>
            <div class="microwave-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 48" fill="none" stroke="#000" stroke-width="2">
                <rect x="2" y="8" width="52" height="32" rx="2"/>
                <circle cx="58" cy="16" r="2"/>
                <circle cx="58" cy="24" r="2"/>
                <circle cx="58" cy="32" r="2"/>
              </svg>
              30초~2분
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </body>
</html>
